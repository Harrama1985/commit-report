{
  "name": "commit-reports",
  "version": "1.0.0",
  "description": "Scan local git projects, group commits by project and date, and turn them into a client-friendly HTML report using Google AI Studio (Gemini).",
  "type": "module",
  "bin": {
    "commit-report": "src/cli.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "git",
    "commits",
    "report",
    "changelog",
    "gemini",
    "ai",
    "client-report",
    "html"
  ],
  "author": "Ghizlane Harrama <ghizlane.tsdi@gmail.com>",
  "license": "MIT",
  "dependencies": {}
}
