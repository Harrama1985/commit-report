{
  "name": "commit-reports",
  "version": "1.0.1",
  "description": "Scan local git projects, group commits by date and then by project, and turn them into a client-friendly HTML report using OpenAI (GPT).",
  "type": "module",
  "bin": {
    "commit-report": "src/cli.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "git",
    "commits",
    "report",
    "changelog",
    "openai",
    "gpt",
    "ai",
    "client-report",
    "html"
  ],
  "author": "Ghizlane Harrama <ghizlane.tsdi@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harrama1985/commit-report.git"
  },
  "homepage": "https://github.com/Harrama1985/commit-report#readme",
  "bugs": {
    "url": "https://github.com/Harrama1985/commit-report/issues"
  },
  "dependencies": {}
}
